{
  "info": {
    "name": "SubTrack",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - demo login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login succeeded', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('token exists', function(){ pm.expect(json.token).to.exist; });",
              "pm.environment.set('token', json.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{ \"email\": \"test@test.com\", \"password\": \"x\" }" },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
      },
      "response": []
    },
    {
      "name": "Subscriptions - create & list",
      "item": [
        {
          "name": "Create Subscription",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('create subscription returns 200', function(){ pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test('has id', function(){ pm.expect(j.id).to.exist; });",
                  "pm.environment.set('lastSubscriptionId', j.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{ \"name\": \"Test\", \"amount\": 9.99 }" },
            "url": { "raw": "{{baseUrl}}/subscriptions", "host": ["{{baseUrl}}"], "path": ["subscriptions"] }
          }
        },
        {
          "name": "List Subscriptions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/subscriptions", "host": ["{{baseUrl}}"], "path": ["subscriptions"] }
          }
        }
      ]
    },
    {
      "name": "AI - chat",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{ \"prompt\": \"Which subscription should I cancel?\" }" },
        "url": { "raw": "{{baseUrl}}/ai/chat", "host": ["{{baseUrl}}"], "path": ["ai", "chat"] }
      },
      "response": []
    },
    {
      "name": "Subscriptions - total",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/subscriptions/total", "host": ["{{baseUrl}}"], "path": ["subscriptions", "total"] }
      }
    }
  ]
}
